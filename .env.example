# 运行环境：dev / prod / test
APP_ENV=prod

# 监听地址（支持 :8080、127.0.0.1:8080 或纯端口号 8080）
HTTP_ADDR=:8080

# 教务接入模式：auto / direct / wfw
JWXT_ACCESS_MODE=auto

# 教务与认证上游请求超时（秒）
JWXT_TIMEOUT_SECONDS=20

# 可信反向代理 CIDR（逗号分隔，留空表示不信任任意代理）
TRUSTED_PROXIES=

# 允许跨域的 Origin 白名单（逗号分隔，留空关闭 CORS）
CORS_ALLOW_ORIGINS=

# 图形验证码与 MFA 事务内存态 TTL（秒）与最大条数
AUTH_TX_TTL_SECONDS=300
AUTH_TX_MAX_ENTRIES=500
